{
  "name": "simple-todo-vscode-extension",
  "displayName": "simple-todo-vscode-extension",
  "description": "Track workspace-scoped tasks with priorities, tags, filters, and JSON import/export.",
  "version": "0.0.1",
  "publisher": "abelrgr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abelrgr/simple-todo-vscode-extension.git"
  },
  "homepage": "https://github.com/abelrgr/simple-todo-vscode-extension",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simpleTodo",
          "title": "Todos",
          "icon": "media/checklist.svg"
        }
      ]
    },
    "views": {
      "simpleTodo": [
        {
          "type": "webview",
          "id": "simpleTodoView",
          "name": "Todos",
          "icon": "media/checklist.svg"
        }
      ]
    },
    "commands": [
        {
        "command": "simpleTodo.addTask",
        "title": "simple-todo-vscode-extension: Add Task"
      },
      {
        "command": "simpleTodo.importTasks",
        "title": "simple-todo-vscode-extension: Import from JSON"
      },
      {
        "command": "simpleTodo.exportTasks",
        "title": "simple-todo-vscode-extension: Export to JSON"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "simpleTodo.addTask",
          "when": "view == simpleTodoView",
          "group": "navigation@0"
        },
        {
          "command": "simpleTodo.importTasks",
          "when": "view == simpleTodoView",
          "group": "navigation@5"
        },
        {
          "command": "simpleTodo.exportTasks",
          "when": "view == simpleTodoView",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "Simple Todos",
      "properties": {}
    }
  },
  "scripts": {
    "compile": "npm run bundle:webview && tsc -p ./",
    "bundle:webview": "node ./scripts/build-webview.js",
    "lint": "tsc --noEmit -p ./",
    "test": "npm run lint && ts-node --transpile-only tests/taskStore.test.ts",
    "prepublish": "npm run compile"
  },
  "devDependencies": {
    "vscode": "^1.1.37",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "esbuild": "^0.21.4",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
